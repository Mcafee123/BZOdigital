# Copy this file to secrets.env (sibling, gitignored) and fill in the real values.
# Then run: ./init_secrets.sh
#
# Do NOT commit secrets.env. The pattern **/secrets.env is in .gitignore.

# --- Container registry ---
ACR_LOGIN_SERVER=""              # e.g. example.azurecr.io
ACR_USERNAME=""                  # admin user or SP with AcrPush
ACR_PASSWORD=""

# --- Azure service principal (used by Terraform) ---
ARM_CLIENT_ID=""
ARM_CLIENT_SECRET=""
ARM_TENANT_ID=""
ARM_SUBSCRIPTION_ID=""

# --- Terraform state backend ---
TF_BACKEND_RESOURCE_GROUP=""
TF_BACKEND_STORAGE_ACCOUNT=""
TF_BACKEND_CONTAINER="tfstate"
TF_BACKEND_KEY="bzo-app-prod.tfstate"

# --- Terraform variables (Container App target) ---
TF_RESOURCE_GROUP=""             # RG that will hold the Container App
TF_CONTAINER_APP_ENV_ID=""       # /subscriptions/.../managedEnvironments/...
TF_ACR_ID=""                     # /subscriptions/.../registries/...

# --- Azure File share (mounted into the Container App) ---
STORAGE_ACCOUNT_NAME=""
STORAGE_ACCOUNT_RESOURCE_GROUP=""
STORAGE_ACCOUNT_KEY=""           # used by upload-data.yml for SMB upload
FILE_SHARE_NAME=""
