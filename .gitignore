**/secrets.env

# Logs
*.log

# Worktrees
.worktrees/

# Node
node_modules/
dist/
.vite/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Terraform
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log

# Real Terraform values (commit *.example versions instead)
terraform.tfvars
*.auto.tfvars
_backend.hcl

# Bootstrap module — references private platform module + hardcodes platform IDs.
# Lives only on the user's local clone. Run once with `terraform apply` to generate
# the per-env _backend.hcl / _init.sh / _platform.auto.tfvars files (also gitignored).
tf/_project_init/

# Per-env files generated by statefiles-generator (contain platform IDs)
tf/**/_init.sh
tf/**/_basics.tf
tf/**/_platform.auto.tfvars
tf/**/_platform_variables.tf
