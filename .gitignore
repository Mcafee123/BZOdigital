# Real terraform.tfvars (commit terraform.tfvars.example only)
terraform.tfvars

# Bootstrap module — references private platform helper modules + pushes GH secrets.
# Lives only on the user's local clone. Run once with `terraform apply` to generate
# the per-env _backend.hcl / _init.sh / _platform.auto.tfvars files.
tf/_project_init/

# Other auto.tfvars (the generated _platform.auto.tfvars IS committed; see below)
*.auto.tfvars
!_platform.auto.tfvars

# Per-env files generated by statefiles-generator ARE committed. They contain
# platform identifiers (tenant, subscription, KV name, state location) but no
# auth-bearing secrets. Anyone reading them learns the platform's topology;
# they cannot use that without ARM_CLIENT_SECRET (which IS a GH secret).

# SP login helper generated at scripts/sp_login.sh — contains SP client_id +
# secret-name pattern. Local convenience only; not needed by CI.
scripts/sp_login.sh
