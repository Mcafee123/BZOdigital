# Copy this file to secrets.env (sibling, gitignored) and fill in the values.
# Then run: ./init_secrets.sh
#
# All other config (ACR, ACE, KV, state location, Cloudflare, etc.) is either
# committed in tf/prod/app/_platform.auto.tfvars or read from the platform's
# terraform state via the read-state helper module — none of those need to be
# GitHub secrets.

# --- Azure service principal (only thing terraform truly needs) ---
ARM_CLIENT_ID=""
ARM_CLIENT_SECRET=""
ARM_TENANT_ID=""
ARM_SUBSCRIPTION_ID=""

# --- SSH deploy key (path, not the value) ---
# Used by CI to clone the private affolterNET helper TF modules during init.
SSH_PRIVATE_KEY_PATH="$HOME/.ssh/id_ed25519"
