# Most values come from the committed _platform.auto.tfvars (generated by
# tf/_project_init via the statefiles-generator helper module). The only
# value CI needs to inject is the image tag from the build job.
#
# Copy to terraform.tfvars (gitignored) for local apply, or pass via
# `-var "image_name=..."` on the command line.

image_name = "anplatformacr.azurecr.io/bzo-app:0.1.0"

