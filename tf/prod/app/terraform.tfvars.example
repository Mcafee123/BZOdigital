# Copy this file to terraform.tfvars and fill in the real values.
# terraform.tfvars is gitignored.

app_name                       = "bzo-app"
resource_group_name            = "CHANGE_ME"
container_app_environment_id   = "/subscriptions/CHANGE_ME/resourceGroups/CHANGE_ME/providers/Microsoft.App/managedEnvironments/CHANGE_ME"
keyvault_id                    = "/subscriptions/CHANGE_ME/resourceGroups/CHANGE_ME/providers/Microsoft.KeyVault/vaults/CHANGE_ME"
acr_login_server               = "CHANGE_ME.azurecr.io"
acr_id                         = "/subscriptions/CHANGE_ME/resourceGroups/CHANGE_ME/providers/Microsoft.ContainerRegistry/registries/CHANGE_ME"
image_name                     = "CHANGE_ME.azurecr.io/bzo-app:0.1.0"

# Azure File share mounted into the Container App at /mnt/repo
storage_account_name           = "CHANGE_ME"
storage_account_resource_group = "CHANGE_ME"
file_share_name                = "CHANGE_ME"

# Optional Cloudflare DNS for a custom hostname. Leave commented (or set custom_domain = null)
# to skip DNS management. When enabled, the module creates the asuid TXT + CNAME records.
# Binding the domain to the Container App (cert + hostname) is a separate manual step.
# custom_domain        = "bzo-app.example.com"
# cloudflare_api_token = "CHANGE_ME"
# cloudflare_zone_id   = "CHANGE_ME"
